# 세션 쿠키(JWT) 서명에 사용하는 비밀 키. 반드시 무작위의 긴 문자열로 교체하세요.
# 생성 예: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-secret-string

# --- 아래 두 항목은 로컬 개발에는 필요 없습니다 (비워두면 자동으로 로컬 파일을 사용) ---
# 배포(Vercel 등) 시에만 값을 채워주세요.

# Turso(원격 SQLite 호환 DB) 연결 정보. https://turso.tech 에서 발급받습니다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob 저장소 토큰. Vercel 프로젝트에서 Blob 스토어를 만들면 자동으로 채워집니다.
BLOB_READ_WRITE_TOKEN=

